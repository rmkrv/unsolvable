# Pull branch-specific values with: neon env pull --file .dev.vars
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_BRANCH=
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=

# Generate unique local secrets with at least 32 characters.
NEON_AUTH_COOKIE_SECRET=

# The exact MCP audience. Use the public HTTPS URL in hosted environments.
MCP_RESOURCE_URL=http://127.0.0.1:5173/mcp

# Google Calendar OAuth web client. Register this callback URL locally:
# http://127.0.0.1:5173/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# A unique secret of at least 32 characters used to encrypt refresh tokens at rest.
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=
